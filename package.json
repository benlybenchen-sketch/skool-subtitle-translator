{
  "name": "skool-vi-subtitle-translator",
  "version": "5.0.0",
  "private": true,
  "description": "Chrome extension (MV3) that translates English lesson videos on Skool into Vietnamese subtitles.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "local-server": "node server/local-translate-server.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.20.5",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.137.0"
  }
}
